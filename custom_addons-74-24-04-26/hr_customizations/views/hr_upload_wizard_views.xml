<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_attendance_upload_wizard" model="ir.ui.view">
        <field name="name">hr.attendance.upload.wizard.form</field>
        <field name="model">hr.attendance.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Attendance Excel">
                <group>
                    <field name="file" filename="filename"/>
                </group>
                <footer>
                    <button name="action_upload"
                            type="object"
                            string="Upload"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Attendance</field>
        <field name="res_model">hr.attendance.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
