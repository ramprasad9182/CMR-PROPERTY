<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_attendance_excel_import_wizard" model="ir.ui.view">
        <field name="name">attendance.excel.import.wizard.form</field>
        <field name="model">attendance.excel.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Attendance Excel">
                <group>
                    <field name="file" filename="filename"/>
                </group>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_excel_import_wizard" model="ir.actions.act_window">
        <field name="name">Upload Excel</field>
        <field name="res_model">attendance.excel.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
