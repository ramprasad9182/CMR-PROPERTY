    <!-- Table rows -->
    <t t-foreach="props.cards" t-as="card" t-key="card.id">
        <div class="d-flex align-items-left py-1 px-2"
             t-att-class="state.selectedCard?.id === card.id ? 'bg-primary text-white rounded' : ''"
             t-on-click="() => this.selectCard(card)" style="cursor:pointer;">
            <div class="flex-grow-1"><t t-esc="card.card_number"/></div>
            <div class="flex-grow-1"><t t-esc="card.mobile"/></div>
            <div class="flex-grow-1"><t t-esc="card.balance"/></div>
        </div>
    </t>
