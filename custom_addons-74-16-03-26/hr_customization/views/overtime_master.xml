<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_overtime_master_tree" model="ir.ui.view">
        <field name="name">hr.overtime.master.tree</field>
        <field name="model">hr.overtime.master</field>
        <field name="arch" type="xml">
            <list string="Overtime Master">
                <field name="name"/>
                <field name="shift_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="amount"/>
            </list>
        </field>
    </record>
    <record id="view_hr_overtime_master_form" model="ir.ui.view">
        <field name="name">hr.overtime.master.form</field>
        <field name="model">hr.overtime.master</field>
        <field name="arch" type="xml">
            <form string="Overtime Master">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="shift_id"/>
                    </group>

                    <group string="Overtime Slab">
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_overtime_master" model="ir.actions.act_window">
        <field name="name">Overtime Master</field>
        <field name="res_model">hr.overtime.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_attendance_overtime_root"
            name="Overtime"
            parent="hr_attendance.menu_hr_attendance_root"
            sequence="25"/>

    <menuitem
            id="menu_attendance_overtime_master"
            name="Overtime Master"
            parent="menu_attendance_overtime_root"
            action="action_hr_overtime_master"
            sequence="10"/>


</odoo>
