<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_hr_upload_list" model="ir.ui.view">
        <field name="name">hr.upload.list</field>
        <field name="model">hr.upload</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="%(action_hr_attendance_upload_wizard)d"
                            string="Upload Excel"
                            type="action"
                            class="btn-primary"
                            display="always"

                    />
                </header>
                <field name="employee_id"/>
                <field name="emp_code"/>
                <field name="department_id"/>
                <field name="attendance_date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="total_time"/>
                <field name="status"/>
                <field name="morning_session"/>
                <field name="afternoon_session"/>

            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_upload_form" model="ir.ui.view">
        <field name="name">hr.upload.form</field>
        <field name="model">hr.upload</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="emp_code"/>
                        <field name="department_id"/>
                        <field name="attendance_date"/>
                        <field name="check_in"/>
                        <field name="check_out"/>
                        <field name="total_time"/>
                        <field name="status"/>
                        <field name="morning_session"/>
                        <field name="afternoon_session"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_upload" model="ir.actions.act_window">
        <field name="name">Attendance Upload</field>
        <field name="res_model">hr.upload</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hr_upload"
              name="Attendance Upload"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_hr_upload"
              sequence="1"/>

</odoo>
