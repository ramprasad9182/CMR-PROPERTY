<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="exap_cash_lists">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
        </t>
        <div class="header" style="text-align: center;">
            <div class="row" style="height: 60px; align-items: center;margin-top:10px;">
                <table style="width:100%; border-collapse:collapse;margin-top:10px;">
                    <tr style="border:1px solid white;">
                        <!-- LEFT : LOGO -->
                        <td style="width:33%; vertical-align:middle; text-align:left;border:1px solid white;">
                            <t t-if="company.logo">
                                <img t-att-src="image_data_uri(company.logo)"
                                     style="width:220px; max-height:120px;"/>
                            </t>
                        </td>

                        <!-- CENTER : COMPANY NAME -->
                        <td style="width:34%; vertical-align:middle; text-align:center; font-weight:bold;border:1px solid white;">
                            <div style="font-size:22px; text-decoration:underline;">
                                CHANDANA BROTHERS
                            </div>
                            <div style="font-size:16px;">
                                MULTI COMPLEX PRIVATE LIMITED
                            </div>
                        </td>

                        <!-- RIGHT : COMPANY DETAILS -->
                        <td style="width:33%; vertical-align:middle; text-align:right;
                   font-size:10px; font-weight:bold;border:1px solid white;
                   font-family:Arial, Verdana, sans-serif;">
                            D.NO:
                            <span t-field="company.street"/>
                            <br/>
                            <span t-field="company.street2"/>
                            <br/>
                            <span t-field="company.city"/>,
                            <span t-field="company.state_id"/>
                            -
                            <span t-field="company.zip"/>
                            <br/>
                            Ph:7670901547
                            <!--                            <span t-field="company.phone"/>-->
                        </td>
                    </tr>
                </table>

            </div>
        </div>

        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
    </template>
    <template id="final_invoice_report_account">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <t t-foreach="docs" t-as="doc">
            <t t-call="nhcl_rental_management.exap_cash_lists">
                <p style="font-size:12px; margin-left:500px; margin-top:0; font-family:Verdana, Arial,sans-serif;font-weight:bold;">
                    <b>CIN NO:</b>
                    <span t-field="company.nhcl_com_cin_no"/>
                    <br/>
                    <b>DIRECTOR:</b>
                    <span t-field="company.nhcl_com__director_name"/>
                    ,
                    <!--                    <br/>-->
                    <b>DIN NO:</b>
                    <span t-field="company.nhcl_com_din_no"/>
                </p>
                <main>
                    <div class="page" style="margin: 20px;">
                        <!-- Header Section -->
                        <h3 style="text-align: center; margin: 0; font-weight: bold; font-family:Arial, Verdana,sans-serif;">
                            <t t-if="doc.nhcl_invoice_type == 'rent'">TAX INVOICE</t>
                            <t t-elif="doc.nhcl_invoice_type == 'cam'">CAM INVOICE</t>
                            <t t-else="">
                                <span t-field="doc.nhcl_invoice_type_label"/>
                                Tax Invoice
                            </t>
                        </h3>

                        <!-- Invoice Details Table -->
                        <table class="table table-bordered"
                               style="width:100%; margin:0; padding:0;
              font-size:12px;
              border:2px solid black;
              font-family:Arial, Verdana, sans-serif;">

                            <!-- 1 -->
                            <tr>
                                <td>
                                    <strong>Tenant</strong>
                                </td>
                                <td>
                                    <span t-field="doc.partner_id.name"/>
                                </td>

                                <td>
                                    <strong>Brand Name</strong>
                                </td>
                                <td>
                                    <span t-field="doc.tenancy_id.brand_name"/>
                                </td>
                            </tr>

                            <!-- 2 -->
                            <tr>
                                <td>
                                    <strong>Address</strong>
                                </td>
                                <td>
                                    <span t-field="doc.partner_id.street"/>,
                                    <span t-field="doc.partner_id.street2"/>,
                                    <br/>

                                    <span t-field="doc.partner_id.city"/>,
                                    <span t-field="doc.partner_id.state_id"/>-
                                    (<span t-field="doc.partner_id.zip"/>)
                                </td>

                                <td>
                                    <strong>Billing Period</strong>
                                </td>
                                <td>
                                    <t t-if="doc.nhcl_invoice_type == 'rs'">
                                         <span t-esc="doc.invoice_month_range and doc.invoice_month_range.replace('/', '-') or ''"/>
<!--                                        <span t-esc="doc.comparision_yr_mnth.name and doc.comparision_yr_mnth.name.replace('/', '-') or ''"/>-->
                                    </t>
                                    <t t-else="">
                                        <span t-esc="doc.invoice_month_range and doc.invoice_month_range.replace('/', '-') or ''"/>
                                    </t>
                                </td>

                            </tr>

                            <!-- 3 -->
                            <tr>
                                <td>
                                    <strong>Tenant PAN No</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.partner_id.l10n_in_pan"/>
                                </td>

                                <td>
                                    <strong>Invoice Number</strong>
                                </td>
                                <td>
                                    <span t-field="doc.name"/>
                                </td>
                            </tr>

                            <!-- 4 -->
                            <tr>
                                <td>
                                    <strong>Tenant GSTIN</strong>

                                </td>
                                <td>
                                    <span t-field="doc.partner_id.vat"/>

                                </td>

                                <td>
                                    <strong>Invoice Date</strong>
                                </td>
                                <td>
                                    <span t-esc="doc.invoice_date.strftime('%d/%b/%Y')"/>
                                </td>
                            </tr>

                            <!-- 5 -->
                            <tr>
                                <td>
                                    <strong>State Name</strong>

                                </td>
                                <td>
                                    <span t-field="doc.partner_id.state_id"/>

                                </td>

                                <td>
                                    <strong>Due Date</strong>
                                </td>
                                <td>
                                    <span t-esc="doc.invoice_date_due.strftime('%d/%b/%Y')"/>
                                </td>
                            </tr>

                            <!-- 6 -->
                            <tr>
                                <td>
                                    <strong>State Code</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.partner_id.state_id.l10n_in_tin"/>
                                </td>

                                <td>
                                    <strong>PAN Number</strong>
                                </td>
                                <td>
                                    <t t-esc="company.l10n_in_pan"/>
                                </td>
                            </tr>

                            <!-- 7 -->
                            <tr>
                                <td>
                                    <strong>Unit No</strong>
                                </td>
                                <td>
                                    <span t-field="doc.tenancy_id.unit_no"/>
                                </td>

                                <td>
                                    <strong>GST IN</strong>
                                </td>
                                <td>
                                    <span t-field="company.vat"/>
                                </td>
                            </tr>

                            <!-- 8 -->
                            <tr>
                                <td>
                                    <strong>Unit Chargeable Area</strong>
                                </td>
                                <td>
                                    <t t-if="doc.nhcl_invoice_type == 'rent'">
                                        <span t-field="doc.tenancy_id.chargeable_area"/>
                                        (Sq.Ft)
                                    </t>
                                    <t t-if="doc.nhcl_invoice_type == 'cam'">
                                        <span t-field="doc.tenancy_id.cam_chargeable_area"/>
                                        (Sq.Ft)
                                    </t>
                                </td>

                                <td>
                                    <strong>State Name</strong>
                                </td>
                                <td>
                                    <span t-field="company.state_id"/>
                                </td>
                            </tr>

                            <!-- 9 -->
                            <tr>
                                <td>
                                    <strong>Unit Carpet Area</strong>
                                </td>
                                <td>
                                    <t t-if="doc.nhcl_invoice_type == 'rent'">
                                        <span t-field="doc.tenancy_id.carpet_area"/>
                                        (Sq.Ft)
                                    </t>
                                    <t t-if="doc.nhcl_invoice_type == 'cam'">
                                        <span t-field="doc.tenancy_id.cam_carpet_area"/>
                                        (Sq.Ft)
                                    </t>
                                </td>

                                <td>
                                    <strong>State Code</strong>
                                </td>
                                <td>
                                    <t t-esc="company.state_id.l10n_in_tin"/>

                                </td>
                            </tr>

                            <!-- 10 -->
                            <tr>
                                <td>
                                    <strong>Place of Supply</strong>
                                </td>
                                <td>
                                    <span t-field="doc.l10n_in_state_id.name"/>
                                </td>

                                <td>
                                    <strong>SAC Code</strong>
                                </td>
                                <td>
                                    <t t-esc="doc.invoice_line_ids[0].l10n_in_hsn_code"/>

                                    <t t-if="doc.nhcl_invoice_type == 'rent'">
                                        <br/>
                                        <span style="font-size:12px;">
                                            Rent services involving owner or non-residential property
                                        </span>
                                    </t>

                                    <t t-if="doc.nhcl_invoice_type == 'cam'">
                                        <br/>
                                        <span style="font-size:12px;">
                                            Maintenance Services or Building Remodeling
                                        </span>
                                    </t>
                                </td>

                            </tr>

                        </table>

                        <table class="table table-sm table-bordered"
                               style="width: 100%; margin: 0; padding:0; font-size: 12px; border: 2px solid black; font-family: Arial, Verdana, sans-serif; text-align: center;">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="text-align: center;">
                                        <strong>Description Of Goods and/or Services</strong>
                                    </th>
                                    <t t-if="doc.nhcl_invoice_type in ('electric')">

                                        <td rowspan="2" style="text-align: center;">
                                            <strong>Opening Date</strong>
                                        </td>
                                        <td rowspan="2" style="text-align: center;">
                                            <strong>Closing Date</strong>
                                        </td>
                                        <td rowspan="2" style="text-align: center;">
                                            <strong>Consumption</strong>
                                        </td>
                                        <td rowspan="2" style="text-align: center;">
                                            <strong>Consumed Units</strong>
                                        </td>
                                    </t>
                                    <t t-if="doc.nhcl_invoice_type == 'rs'">
                                        <th rowspan="2" style="text-align: center;">
                                            <strong>Net Rent</strong>
                                        </th>
                                        <th rowspan="2" style="text-align: center;">
                                            <strong>loading Percentage</strong>
                                        </th>
                                        <!--                                            <th rowspan="2" style="text-align: center;">-->
                                        <!--                                                <strong>Rate</strong>-->
                                        <!--                                            </th>-->

                                    </t>
                                    <t t-if="doc.nhcl_invoice_type in ('rent','cam','gas','signage')">
                                        <th rowspan="2" style="text-align: center;">
                                            <strong>Area Units</strong>
                                        </th>
                                    </t>
                                    <t t-if="doc.nhcl_invoice_type in ('slb')">
                                        <th rowspan="2" colspan="2" style="text-align: center;">
                                            <strong>Rate</strong>
                                        </th>
                                    </t>
                                    <t t-else="">
                                        <th rowspan="2" style="text-align: center;">
                                            <strong>Rate</strong>
                                        </th>
                                    </t>


                                    <th rowspan="2" style="text-align: center;">
                                        <strong>Total Value</strong>
                                    </th>
                                    <th rowspan="2" style="text-align: center;">
                                        <strong>Taxable Value</strong>
                                    </th>
                                    <th colspan="2" style="text-align: center;">
                                        <strong>CGST</strong>
                                    </th>
                                    <th colspan="2" style="text-align: center;">
                                        <strong>SGST</strong>
                                    </th>
                                </tr>
                                <t t-if="doc.nhcl_invoice_type in ('electric')">

                                    <tr>
                                        <!--                                    <th colspan="9"></th>-->
                                        <th style="font-weigh:bold;">
                                            <strong>Rate</strong>
                                        </th>
                                        <th style="font-weigh:bold;">
                                            <strong>Amount</strong>
                                        </th>
                                        <th style="font-weigh:bold;">
                                            <strong>Rate</strong>
                                        </th>
                                        <th style="font-weigh:bold;">
                                            <strong>Amount</strong>
                                        </th>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <!--                                    <th colspan="5"></th>-->
                                        <th style="font-weigh:bold;">
                                            <strong>Rate</strong>
                                        </th>
                                        <th style="font-weigh:bold;">
                                            <strong>Amount</strong>
                                        </th>
                                        <th style="font-weigh:bold;">
                                            <strong>Rate</strong>
                                        </th>
                                        <th style="font-weigh:bold;">
                                            <strong>Amount</strong>
                                        </th>
                                    </tr>
                                </t>
                            </thead>
                            <tbody>
                                <!-- Line Items -->
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td style="text-align: left;">
                                            <t t-if="doc.nhcl_invoice_type in ['rent','cam']">
                                                <span t-field="line.description2"/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="line.product_id.name"/>(<span t-field="line.name"/>)
                                            </t>
                                            <!--                                                <span t-field="line.product_id.name"/>(<span t-field="line.name"/>)-->
                                        </td>


                                        <!-- Show fields only if the invoice type is 'cam' -->
                                        <t t-if="doc.nhcl_invoice_type in ('electric')">

                                            <td>
                                                <span t-field="line.opening_reading"/>
                                            </td>
                                            <td>
                                                <span t-field="line.closing_reading"/>
                                            </td>
                                            <td>
                                                <span t-field="line.consumption"/>
                                            </td>
                                            <td>
                                                <span t-field="line.consumed_units"/>
                                            </td>
                                        </t>
                                        <t t-if="doc.nhcl_invoice_type == 'rs'">
                                            <td>
                                                <span t-field="line.net_rent"/>
                                            </td>
                                            <td>
                                                <span t-field="line.percentage"/>
                                            </td>
                                            <!--                                                <td>-->
                                            <!--                                                    <span t-field="line.price_unit"/>-->
                                            <!--                                                </td>-->

                                        </t>
                                        <t t-if="doc.nhcl_invoice_type in ('rent','cam','gas','signage')">
                                            <td>
                                                <span t-field="line.nhcl_area_units"/>
                                            </td>
                                        </t>
                                        <t t-if="doc.nhcl_invoice_type in ('slb')">
                                            <td colspan="2" style="text-align: center;">
                                                <span t-esc="'{:,.0f}'.format(line.price_unit)"/>
                                            </td>
                                        </t>
                                        <t t-else="">
                                            <td style="text-align: center;">
                                                <t t-if="doc.nhcl_invoice_type in ('rent','cam') and doc.tenancy_id.sft_fixed == 'Fixed'">
                                                    <span>0</span>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="'{:,.0f}'.format(line.price_unit)"/>
                                                </t>
                                            </td>

                                        </t>


                                        <!--                                        <td>-->
                                        <!--                                            <span t-esc="'{:,.0f}'.format(line.price_unit)"/>-->
                                        <!--                                        </td>-->


                                        <td style="font-weigh:bold;">
                                            <span t-esc="'{:,.0f}'.format(doc.total_amount_show)"/>
                                        </td>
                                        <td style="font-weigh:bold;">
                                            <span t-esc="'{:,.0f}'.format(doc.total_amount_show)"/>
                                            <!--                                            <t t-esc="'{:,.0f}'.format(sum(line.mapped('price_total')) - sum(line.mapped('price_subtotal')))"/>-->
                                        </td>

                                        <td>
                                            <t t-foreach="line.tax_ids.filtered(lambda tax: 'gst' in tax.name.lower())"
                                               t-as="gst_tax">

                                                <t t-esc="gst_tax.amount / 2"/>%
                                            </t>
                                        </td>
                                        <td>
                                           <t t-foreach="line.tax_ids.filtered(lambda tax: 'gst' in tax.name.lower())"
                                               t-as="gst_tax">

                                                <t t-esc="int(round((line.price_total - line.price_subtotal) / 2, 0)) if gst_tax else 0"/>
                                            </t>

                                        </td>
                                        <td>
                                            <t t-foreach="line.tax_ids.filtered(lambda tax: 'gst' in tax.name.lower())"
                                               t-as="gst_tax">

                                                <t t-esc="gst_tax.amount / 2"/>%
                                            </t>
                                        </td>
                                        <td>
                                           <t t-foreach="line.tax_ids.filtered(lambda tax: 'gst' in tax.name.lower())"
                                               t-as="gst_tax">

                                                <t t-esc="int(round((line.price_total - line.price_subtotal) / 2, 0)) if gst_tax else 0"/>
                                            </t>

                                        </td>
                                    </tr>
                                </t>
                                <!-- Total Row -->
                                <tr>
                                    <td>
                                        <strong>Total</strong>
                                    </td>
                                    <t t-if="doc.nhcl_invoice_type in ('electric')">

                                        <td colspan="5"></td>
                                    </t>
                                    <t t-elif="doc.nhcl_invoice_type in ('rent','cam','gas','signage')">
                                        <td colspan="2"></td>
                                    </t>
                                    <t t-elif="doc.nhcl_invoice_type == 'rs'">
                                        <td colspan="3"></td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="2"></td>
                                    </t>
                                    <td>
                                        <t t-esc="'{:,.0f}'.format(doc.total_amount_show)"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.0f}'.format(doc.total_amount_show)"/>


                                        <!--                                        <t t-esc="'{:,.0f}'.format(sum(doc.invoice_line_ids.mapped('price_total')) - sum(doc.invoice_line_ids.mapped('price_subtotal')))"/>-->
                                    </td>
                                    <td></td>
                                    <td>
                                        <t t-esc="'{:,.0f}'.format((sum(doc.invoice_line_ids.mapped('price_total')) - sum(doc.invoice_line_ids.mapped('price_subtotal')))/2)"/>
                                    </td>
                                    <td></td>
                                    <td>
                                        <t t-esc="'{:,.0f}'.format((sum(doc.invoice_line_ids.mapped('price_total')) - sum(doc.invoice_line_ids.mapped('price_subtotal')))/2)"/>
                                    </td>
                                </tr>
                                <!-- Invoice Total in Figure -->
                                <t t-if="doc.nhcl_invoice_type in ('electric')">

                                    <tr>
                                        <td>
                                            <strong>Total Invoice Value (In Figures)</strong>
                                        </td>
                                        <td colspan="12" style="text-align: left;font-weight:bold;">
                                            <span t-esc="'{:,.0f}'.format(abs(doc.amount_total_signed))"/>
                                        </td>
                                    </tr>
                                    <!-- Invoice Total in Words -->
                                    <tr>
                                        <td>
                                            <strong>Total Invoice Value (In Words)</strong>
                                        </td>
                                        <td colspan="12" style="text-align: left;font-weight:bold;">
                                            <strong>
                                                <span t-esc="doc.amount_in_words"/>&amp;nbsp;only
                                            </strong>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td>
                                            <strong>Total Invoice Value (In Figures)</strong>
                                        </td>
                                        <td colspan="9" style="text-align: left;font-weight:bold;">
                                            <span t-esc="'{:,.0f}'.format(abs(doc.amount_total_signed))"/>
                                        </td>
                                    </tr>
                                    <!-- Invoice Total in Words -->
                                    <tr>
                                        <td>
                                            <strong>Total Invoice Value (In Words)</strong>
                                        </td>
                                        <td colspan="12" style="text-align: left;font-weight:bold;">
                                            <span t-esc="doc.amount_in_words"/>&amp;nbsp;only.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </main>
                <p style="margin:0px;">
                    <strong>Note</strong>
                </p>

                <span style="font-family:Verdana, Arial, sans-serif; font-size: 12px; margin: 0; padding: 0;">
                    <t t-if="doc.nhcl_invoice_type == 'cam'">
                        <p style="font-family:Verdana, Arial, sans-serif; font-size: 12px;">
                            1. Please Make Payment Through RTGS as per details below.
                            <br/>
                            <span t-field="company.name"/>-10846381193-SBIN0000952-SBI-Rednam Gardens."
                            <br/>
                            2. Cheque/D.D in favour of Chandana Brothers Multi Complex Private Limited - 10846381193 -
                            SBI-Rednam Gardens.
                            <br/>
                            3. Amount billed to be settled before due date. Delay in payment will Attract Interest as
                            per
                            the Lease Agreement and other penal provisions or as per management policy.
                            <br/>
                            4. Any clarifications regarding bill should be notified to the mall office within 2 days,
                            else
                            its considered your acceptance.

                        </p>

                    </t>
                    <t t-elif="doc.nhcl_invoice_type == 'rent'">
                        <p style="margin:0px;">1.Please Make Payment Through RTGS as per details below.
                            <br/>
                            <span t-field="company.name"/>-10846381193-SBIN0000952-SBI-Rednam
                            Gardens.
                            <br/>
                            2. Cheque/D.D in favour of Chandana Brothers Multi Complex Private Limited - 10846381193 -
                            SBI-Rednam Gardens.
                            <br/>
                            3.Amount billed to be settled before due date. Delay in payment will Attract Interest as per
                            the Lease Agreement and other penal provisions or as per management policy.
                            <br/>
                            4.Any clarifications regarding bill should be notified to the mall office within 2 days
                            ,else its considered your acceptance.
                        </p>
                    </t>

                    <t t-elif="doc.nhcl_invoice_type == 'electric'">
                        <p>
                            1.Please Make Payment Through RTGS as per details below.
                            <br/>
                            <span t-field="company.name"/>-10846381193-SBIN0000952-SBI-Rednam Gardens.
                            <br/>
                            2.Amount billed to be settled before due date . Delay in payment will Attract Interest as
                            per
                            the Lease Agreement and other penal provisions or as per management policy.
                            <br/>
                            3. Any clarifications regarding bill should be notified to the mall office within 2 days
                            ,else
                            its considered your acceptance.
                            <br/>
                            4. Non settlement of the utility charges by the due date will lead to surcharge and
                            disconnection.
                            * As the Energy Meter is Automatically resettled to 0 , two meter reading are mentioned
                            above.
                            ** As per APEPDCL Regulatory Commission Act, there is hike in unit rate ( Fuel Surcharges
                            Levied
                            )
                        </p>
                    </t>
                    <t t-elif="doc.nhcl_invoice_type == 'gas'">
                        <p>
                            1.Please Make Payment Through RTGS as per details below.
                            <br/>
                            <span t-field="company.name"/>-10846381193-SBIN0000952-SBI-Rednam
