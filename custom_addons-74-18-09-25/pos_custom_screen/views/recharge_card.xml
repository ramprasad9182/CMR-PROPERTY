<odoo>
    <!-- Recharge list -->
    <record id="view_food_court_recharge_list" model="ir.ui.view">
        <field name="name">food.court.recharge.list</field>
        <field name="model">food.court.recharge</field>
        <field name="arch" type="xml">
            <list>
                <field name="card_number"/>
                <field name="customer_name"/>
                <field name="amount"/>
                <field name="reason"/>
                <field name="recharge_on"/>
                <field name="payment_method"/>
                <field name="receipt_number"/>
            </list>
        </field>
    </record>

    <!-- Recharge Form -->
    <record id="view_food_court_recharge_form" model="ir.ui.view">
        <field name="name">food.court.recharge.form</field>
        <field name="model">food.court.recharge</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recharge_card" type="object" string="Recharge Card" class="oe_highlight"
                    />
                </header>
                <sheet>
                    <div style="Background-color:#6e3de1cc; margin:0px;padding:10px;border:1px solid #4f4e4a;">
                    <div style="margin-bottom: 10px; font-size: 18px;color:white;">
                        Details
                    </div>
                    <group>
                        <group>
                            <field name="card_id" style="color: yellow;"/>
                            <field name="card_number" readonly="1" style="color: white;"/>
                        </group>
                        <group>
                            <field name="issue" readonly="1" style="color: white;"/>
                            <field name="inactive" readonly="1" style="color: white;"/>
                        </group>
                        <br/>
                        <group>

                            <field name="mobile" readonly="1" style="color: white;"/>
                            <field name="customer_name" readonly="1" style="color: white;"/>
                            <!--                            -->
                            <field name="card_amount" readonly="1" style="color: white;"/>
                            <field name="card_deposit" readonly="1" style="color: white;"/>

                        </group>
                        <group>
                            <field name="issue_date" readonly="1" style="color: white;"/>
                            <field name="deposit_used" readonly="1" style="color: white;"/>
                            <field name="used" readonly="1" style="color: white;"/>
                            <field name="balance" readonly="1" style="color: white;"/>
                            <field name="redeemable_balance" readonly="1" style="color: white;"/>
                        </group>
                    </group>
                    <br/>
                    <group>
                        <group>
                            <field name="amount" style="color: white;"/>
                            <field name="recharge_on" style="color: white;"/>
                            <field name="receipt_number" style="color: white;"/>
                        </group>
                        <group>
                            <field name="reason" style="color: white;"/>
                            <field name="payment_method" widget="radio" options="{'horizontal': true}" style="color: yellow;"/>
                        </group>
                    </group>

                    <br/>
                        <div class="row" style="margin:5px;gap:10px;">
    <button string="10" type="object" name="action_recharge"
            context="{'amount': 10}"
            class="btn btn-primary col-md-1"
            style="margin:5px;"/>
    <button string="20" type="object" name="action_recharge"
            context="{'amount': 20}"
            class="btn btn-primary col-md-1"
            style="margin:5px;"/>
    <button string="50" type="object" name="action_recharge"
            context="{'amount': 50}"
            class="btn btn-primary col-md-1"
            style="margin:5px;"/>
    <button string="100" type="object" name="action_recharge"
            context="{'amount': 100}"
            class="btn btn-primary col-md-1"
            style="margin:5px;"/>
    <button string="200" type="object" name="action_recharge"
            context="{'amount': 200}"
            class="btn btn-primary col-md-1"
            style="margin:5px;"/>
    <button string="500" type="object" name="action_recharge"
            context="{'amount': 500}"
            class="btn btn-primary col-md-1"
            style="margin:5px;"/>
    <button string="2000" type="object" name="action_recharge"
            context="{'amount': 2000}"
            class="btn btn-primary col-md-1"
            style="margin:5px;"/>
    <button string="Clear" type="object" name="action_clear_balance"
            class="btn btn-warning col-md-1"
            style="margin:5px;"/>
</div>
<!--                    <group>-->
<!--                        <group>-->
<!--                            <button string="10" type="object" name="action_recharge" context="{'amount': 10}"-->
<!--                                    class="btn-primary"/>-->
<!--                            <button string="20" type="object" name="action_recharge" context="{'amount': 20}"-->
<!--                                    class="btn-primary"/>-->
<!--                            <button string="50" type="object" name="action_recharge" context="{'amount': 50}"-->
<!--                                    class="btn-primary"/>-->
<!--                            <button string="100" type="object" name="action_recharge" context="{'amount': 100}"-->
<!--                                    class="btn-primary"/>-->
<!--                        </group>-->
<!--                        <group>-->
<!--                            <button string="200" type="object" name="action_recharge" context="{'amount': 200}"-->
<!--                                    class="btn-primary"/>-->
<!--                            <button string="500" type="object" name="action_recharge" context="{'amount': 500}"-->
<!--                                    class="btn-primary"/>-->
<!--                            <button string="2000" type="object" name="action_recharge" context="{'amount': 2000}"-->
<!--                                    class="btn-primary"/>-->
<!--                            <button string="Clear" type="object" name="action_clear_balance" class="btn-warning"/>-->
<!--                        </group>-->
<!--                    </group>-->
                    </div>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Recharge Action -->
    <record id="action_food_court_recharge" model="ir.actions.act_window">
        <field name="name">Recharges</field>
        <field name="res_model">food.court.recharge</field>
        <field name="view_mode">form,list</field>
    </record>

    <!-- Recharge Menu -->
    <!--    <menuitem id="menu_food_court_recharge" name="Recharge" parent="menu_food_court_root"-->
    <!--              action="action_food_court_recharge"/>-->
</odoo>
